              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns a paginated list of inventory items (SKUs)."
        },
        {
          "info": {
            "name": "Create an item",
            "type": "http"
          },
          "http": {
            "method": "POST",
