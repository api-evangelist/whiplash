{
  "opencollection": "1.0.0",
  "info": {
    "name": "Whiplash (Rydership) Bundle Items Customers API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Customers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getwhiplash.com/v2/customers",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per page"
              }
            ]
          },
          "docs": "Returns a paginated list of customers."
        },
        {
          "info": {
            "name": "Count customers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getwhiplash.com/v2/customers/count"
          },
          "docs": "Count customers"
        },
        {
          "info": {
            "name": "List available customer actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getwhiplash.com/v2/customers/actions"
          },
          "docs": "List available customer actions"
        },
        {
          "info": {
            "name": "Retrieve a customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getwhiplash.com/v2/customers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              }
            ]
          },
          "docs": "Retrieve a customer"
        },
        {
          "info": {
            "name": "Update a customer",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.getwhiplash.com/v2/customers/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a customer"
        }
      ]
    }
  ],
  "bundled": true
}